APP_ENV=demo
DATA_PROVIDER=auto
# Only the explicit offline ingestion command uses this credential.
UQER_TOKEN=
MARKET_TICKER=c2701
DATA_START_DATE=2025-12-31
DATA_END_DATE=2026-10-23
# Container reads ./var/market and ./var/comparison through a read-only mount.
DEMO_DATA_DIR=./var
CORS_ORIGINS=http://localhost:5173,http://frontend:8080

# Accounts are inserted by private DML; login never creates users.
# MySQL 8 via an SSH tunnel. Keep the actual password only in the ignored .env.
# Format: mysql://USER:PERCENT_ENCODED_PASSWORD@127.0.0.1:3313/grain_guard
PLATFORM_DATABASE_URL=
# Required: replace the template privately. MySQL schema is installed by its DDL owner.
